# ==============================================================================
# Fullstack Project Root .gitignore (Clinic Monorepo / Multi-Folder)
# ==============================================================================

# 1. Dependencies (Semua node_modules di root & subfolder)
**/node_modules/
node_modules/

# 2. Environment Variables & Secrets (Sangat Penting!)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# 3. Build & Compiled Outputs
**/dist/
**/dist-ssr/
**/build/
**/generated/

# 4. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# 5. IDE & OS Configuration Files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.windsurf/
.claude/
.agents/

# 6. Testing & Coverage
**/coverage/
.nyc_output/

# 7. Local Storage / Temporary Files
*.local
.localstorage*

# 8. Markdown Notes & Documentation Backlogs
NOTE_*.md
NOTE*.md
*.tmp.md